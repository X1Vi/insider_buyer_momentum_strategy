# Groww API key/secret, used to generate an access token at startup via the
# checksum flow (POST /v1/token/api/access). Create these on the Groww Cloud
# API Keys page and approve them there each day: https://groww.in/trade-api/docs/curl
GROWW_API_KEY=your_groww_api_key
GROWW_API_SECRET=your_groww_api_secret

# Optional fallback if key/secret refresh is unavailable. The insider API tries
# GROWW_API_KEY + GROWW_API_SECRET first so a stale daily token is not reused.
GROWW_ACCESS_TOKEN=

# Optional location for the insider web app's persistent 24-hour NSE/Groww cache.
# The bundled run_app.sh sets this to india_insider_drift/data/app_cache.
# INSIDER_CACHE_DIR=/absolute/path/to/cache

# Pushover push notifications (https://pushover.net). Required for phone alerts.
# PUSHOVER_APP_TOKEN = API token from "Your Applications" (create one named e.g. spread_reversion)
# PUSHOVER_USER_KEY  = your 30-char User Key from the dashboard
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# ---- BTC paper-trading bot (src/bin/btc_bot.rs) --------------------------
# All optional; the defaults shown are used when unset.
# BTC_BOT_SYMBOL=BTCUSDT        # the single symbol the paper bot trades
# BTC_BOT_CASH=1000             # starting paper capital
# BTC_BOT_POLL_MINS=15          # poll cadence in --daemon mode (1..720)
# BTC_WATCHLIST=BTCUSDT,THETAUSDT   # symbols the screener evaluates
